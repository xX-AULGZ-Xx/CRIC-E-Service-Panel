{
  "realm": "cric-college",
  "displayName": "CRIC College E-Services",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      { "name": "admin", "description": "CRIC System Administrator" },
      { "name": "teacher", "description": "CRIC College Instructor/Teacher" },
      { "name": "staff", "description": "CRIC College Staff" },
      { "name": "student", "description": "CRIC College Student" }
    ]
  },
  "clients": [
    {
      "clientId": "cric-portal",
      "name": "CRIC E-Service Portal",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "cric-portal-secret-key",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3000/api/auth/callback/keycloak",
        "http://127.0.0.1:3000/*",
        "https://panel.cric.ac.th/*",
        "https://panel.cric.ac.th/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "*"
      ],
      "publicClient": false,
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "cric-plan-app",
      "name": "ระบบแผนงานและงบประมาณ (CRIC Plan)",
      "rootUrl": "https://plan.cric.ac.th",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "cric-plan-secret-key-2026",
      "redirectUris": [
        "https://plan.cric.ac.th/*",
        "https://plan.cric.ac.th/auth/callback",
        "http://localhost:8001/*"
      ],
      "webOrigins": [
        "*"
      ],
      "publicClient": false,
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "cric-rcms-app",
      "name": "ระบบบริหารจัดการงานวิจัยและวิทยาลัย (CRIC RCMS)",
      "rootUrl": "https://rcms.cric.ac.th",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "cric-rcms-secret-key-2026",
      "redirectUris": [
        "https://rcms.cric.ac.th/*",
        "https://rcms.cric.ac.th/auth/callback",
        "https://panel.cric.ac.th/*",
        "http://localhost:3006/*",
        "http://localhost:3006/auth/callback",
        "http://localhost:8002/*"
      ],
      "webOrigins": [
        "*"
      ],
      "publicClient": false,
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "picture",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "picture",
            "claim.name": "picture",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviderMappers": [
    {
      "name": "google-picture",
      "identityProviderAlias": "google",
      "identityProviderMapper": "google-user-attribute-mapper",
      "config": {
        "syncMode": "FORCE",
        "claim": "picture",
        "user.attribute": "picture"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@cric.ac.th",
      "firstName": "CRIC",
      "lastName": "Administrator",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["admin", "staff"]
    },
    {
      "username": "student",
      "enabled": true,
      "email": "student01@cric.ac.th",
      "firstName": "Somchai",
      "lastName": "Student",
      "credentials": [
        {
          "type": "password",
          "value": "student123",
          "temporary": false
        }
      ],
      "realmRoles": ["student"]
    },
    {
      "username": "teacher",
      "enabled": true,
      "email": "teacher01@cric.ac.th",
      "firstName": "Ajarn",
      "lastName": "Prasert",
      "credentials": [
        {
          "type": "password",
          "value": "teacher123",
          "temporary": false
        }
      ],
      "realmRoles": ["teacher"]
    }
  ]
}
