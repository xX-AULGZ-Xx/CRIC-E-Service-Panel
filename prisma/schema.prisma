generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  sortOrder   Int       @default(0)
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Service {
  id                String         @id @default(cuid())
  title             String
  description       String?
  url               String
  iconUrl           String
  categoryId        String?
  category          Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  allowedRoles      String[]       @default([]) // e.g. ["student", "teacher", "staff", "admin"]
  openInNewTab      Boolean        @default(true)
  isActive          Boolean        @default(true)
  isDefaultFavorite Boolean        @default(false)
  sortOrder         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  userFavorites     UserFavorite[]

  @@map("services")
}

model UserFavorite {
  id        String   @id @default(cuid())
  userId    String   // Keycloak sub or user id
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, serviceId])
  @@map("user_favorites")
}

model SystemSetting {
  id                        String   @id @default("default")
  collegeNameTh             String   @default("วิทยาลัยอาชีวศึกษา CRIC")
  collegeNameEn             String   @default("CRIC Vocational College")
  portalTitle               String   @default("CRIC E-Service Panel")
  portalSubtitle            String   @default("ศูนย์รวมบริการดิจิทัลสำหรับนักศึกษาและบุคลากร")
  logoUrl                   String?
  contactEmail              String?  @default("support@cric.ac.th")
  contactPhone              String?  @default("02-123-4567")
  helpdeskUrl               String?  @default("https://helpdesk.cric.ac.th")
  footerText                String   @default("© 2026 CRIC College. All rights reserved.")
  maintenanceMode           Boolean  @default(false)
  maintenanceMessage        String   @default("ระบบกำลังอยู่ระหว่างการปรับปรุงชั่วคราว เพื่อพัฒนาประสิทธิภาพการบริการ ขออภัยในความไม่สะดวก")
  allowUserCustomFavorites  Boolean  @default(true)
  showEmbedWidgetSnippet    Boolean  @default(true)
  demoModeEnabled           Boolean  @default(true)
  keycloakRealm             String   @default("cric-college")
  allowedEmailDomains       String   @default("cric.ac.th, student.cric.ac.th")
  sessionTimeoutMinutes     Int      @default(120)

  // Google OAuth 2.0 Integration
  googleAuthEnabled         Boolean  @default(false)
  googleClientId            String?
  googleClientSecret        String?
  googleHostedDomain        String?  @default("cric.ac.th")

  updatedAt                 DateTime @updatedAt

  @@map("system_settings")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  passwordHash String?
  displayName  String
  department   String?
  role         String    @default("student") // admin | teacher | staff | student
  avatarUrl    String?
  isActive     Boolean   @default(true)
  authProvider String    @default("local") // local | google
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}
