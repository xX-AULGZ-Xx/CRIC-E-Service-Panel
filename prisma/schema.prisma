generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  sortOrder   Int       @default(0)
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Service {
  id                String         @id @default(cuid())
  title             String
  description       String?
  url               String
  iconUrl           String
  categoryId        String?
  category          Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  allowedRoles      String[]       @default([]) // e.g. ["student", "teacher", "staff", "admin"]
  openInNewTab      Boolean        @default(true)
  isActive          Boolean        @default(true)
  isDefaultFavorite Boolean        @default(false)
  sortOrder         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  userFavorites     UserFavorite[]

  @@map("services")
}

model UserFavorite {
  id        String   @id @default(cuid())
  userId    String   // Keycloak sub or user id
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, serviceId])
  @@map("user_favorites")
}

model SystemSetting {
  id                        String   @id @default("default")
  collegeNameTh             String   @default("วิทยาลัยการอาชีพเชียงราย")
  collegeNameEn             String   @default("CRIC Vocational College")
  portalTitle               String   @default("CRIC E-Service Panel")
  portalSubtitle            String   @default("ศูนย์รวมระบบบริการดิจิทัล วิทยาลัยการอาชีพเชียงราย เข้าสู่ระบบด้วยบัญชีสถาบันเพื่อเข้าถึงบริการทั้งหมด")
  logoUrl                   String?
  contactEmail              String?  @default("support@cric.ac.th")
  contactPhone              String?  @default("02-123-4567")
  helpdeskUrl               String?  @default("https://helpdesk.cric.ac.th")
  footerText                String   @default("© 2026 CRIC College. All rights reserved.")
  maintenanceMode           Boolean  @default(false)
  maintenanceMessage        String   @default("ระบบอยู่ระหว่างปิดปรับปรุงชั่วคราว ขออภัยในความไม่สะดวก")
  allowUserCustomFavorites  Boolean  @default(true)
  showEmbedWidgetSnippet    Boolean  @default(true)
  demoModeEnabled           Boolean  @default(true)
  keycloakRealm             String   @default("cric-college")
  allowedEmailDomains       String   @default("cric.ac.th, student.cric.ac.th")
  sessionTimeoutMinutes     Int      @default(120)

  // Google OAuth 2.0 Integration
  googleAuthEnabled         Boolean  @default(false)
  googleClientId            String?
  googleClientSecret        String?
  googleHostedDomain        String?  @default("cric.ac.th")

  // Keycloak Central SSO Integration
  keycloakPublicUrl         String?  @default("https://sso.cric.ac.th")
  keycloakInternalUrl       String?  @default("http://keycloak:8080")
  keycloakClientId          String?  @default("cric-portal")
  keycloakClientSecret      String?
  centralGatewayEnabled     Boolean  @default(true)

  updatedAt                 DateTime @updatedAt

  @@map("system_settings")
}

model Division {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  externalId  Int?         @unique
  departments Department[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("divisions")
}

model Department {
  id          String           @id @default(cuid())
  divisionId  String
  division    Division         @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  name        String
  externalId  Int?             @unique
  users       UserDepartment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("departments")
}

model UserDepartment {
  id           String     @id @default(cuid())
  userId       String
  departmentId String
  isHead       Boolean    @default(false)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@map("user_departments")
}

model User {
  id            String           @id @default(cuid())
  username      String           @unique
  email         String           @unique
  passwordHash  String?
  displayName   String
  department    String?
  position      String?
  personnelType String?          @default("STAFF") // TEACHER | STAFF | STUDENT
  role          String           @default("student") // admin | director | deputy_director | planning_officer | head_dept | teacher | staff | student
  avatarUrl     String?
  isActive      Boolean          @default(true)
  authProvider  String           @default("local") // local | google | keycloak
  sourceSystem  String?          @default("local") // local | plan | rcms
  externalId    String?
  lastLoginAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  departments   UserDepartment[]

  @@map("users")
}
