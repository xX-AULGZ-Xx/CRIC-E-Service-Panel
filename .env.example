# Database (PostgreSQL - Docker host port 5433 to avoid conflict with local port 5432)
DATABASE_URL="postgresql://cric_user:cric_password@localhost:5433/cric_portal_db?schema=public"

# Keycloak Identity Provider (OIDC / OAuth 2.0 - Docker host port 8085)
KEYCLOAK_HOSTNAME="sso.cric.ac.th"
KEYCLOAK_URL="http://localhost:8085"
KEYCLOAK_REALM="cric-college"
KEYCLOAK_CLIENT_ID="cric-portal"
KEYCLOAK_CLIENT_SECRET="cric-portal-secret-key"

# Next.js Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cric-secure-jwt-secret-key-super-random-32char"

# Admin Mock / Dev Mode Switch
ENABLE_DEV_ROLE_SWITCHER="true"
